# 복사해서 사용: cp .env.example .env   (.env 는 gitignore 처리됨)

# --- 감시 조건 ---
WATCH_DEP=서울
WATCH_ARR=부산
WATCH_DATE=2026-12-25          # YYYY-MM-DD 또는 YYYYMMDD
WATCH_TIME_FROM=08:00          # 이 시각 이후 출발
WATCH_TIME_TO=12:00            # 이 시각 이전 출발
WATCH_TRAIN_TYPE=ktx           # all | ktx | saemaeul | itx-saemaeul | mugunghwa | itx-cheongchun
WATCH_ADULTS=1

# seat             : 일반실 좌석만
# seat_or_standing : 일반실 좌석 또는 입석+좌석
SEAT_MODE=seat_or_standing

# 조회 간격(분). 최소 3분
CHECK_INTERVAL_MINUTES=5

# --- 텔레그램 ---
TELEGRAM_BOT_TOKEN=123456789:replace-me
TELEGRAM_CHAT_ID=123456789
NOTIFY_ON_START=true
